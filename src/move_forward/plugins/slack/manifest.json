{
  "display_information": {
    "name": "Move forward",
    "description": "A local dashboard of work in flight: reads what's waiting on you in Slack, and helps ping reviewers.",
    "background_color": "#2c2d30"
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:8765/slack/callback",
      "https://localhost:8765/slack/callback"
    ],
    "scopes": {
      "user": ["users:read", "users:read.email"]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
