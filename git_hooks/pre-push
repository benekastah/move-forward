#!/bin/sh
# Run ./check.sh before pushing, unless the push only deletes remote branches.
# Skip it with `git push --no-verify`.
#
# git passes each ref being pushed on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>"; a deletion's local sha
# is all zeros.

set -eu

pushes_commits=false
while read -r _ local_sha _ _; do
    case "$local_sha" in
        *[!0]*) pushes_commits=true ;;
    esac
done

if [ "$pushes_commits" = true ]; then
    exec ./check.sh -q
fi
